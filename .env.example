# Local development environment variables
NODE_ENV=development
DATABASE_URL=postgres://localhost:5432/amandi_tharindu
SESSION_SECRET=replace-with-a-secure-random-value

# Admin account (single admin). REQUIRED to use /admin at all -- there is no
# fallback account, locally or otherwise. Generate both values with:
#   npm run admin:hash
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# Supabase Storage (Slice 13-17 image uploads). SUPABASE_URL and
# SUPABASE_SERVICE_ROLE_KEY are required for POST /api/admin/upload to work --
# without them it returns 503 storage_not_configured and the app otherwise
# runs normally. SUPABASE_ANON_KEY is not used server-side (uploads go through
# the service role key only) but is kept here in case a client-side use
# appears later.
# After setting these, run once: npm run setup-storage
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Optional service placeholders for future integrations
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=
# RESEND_API_KEY=
