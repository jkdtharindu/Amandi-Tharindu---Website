# ===================================================================
# Amandi & Tharindu Wedding Website — Environment Configuration
# ===================================================================
#
# IMPORTANT: Copy this file to .env and fill in real values.
# NEVER commit .env to git — it contains secrets.
# Use .env.local for local development (git-ignored).
#
# For production deployments, use Vercel Secrets or your host's
# secure environment variable storage.
#
# ===================================================================

# -------------------------------------------------------------------
# Core Application Configuration
# -------------------------------------------------------------------

# Runtime environment: 'development' or 'production'
# Controls security settings (HTTPS, secure cookies, debug logging)
NODE_ENV=development

# Application port (default: 3000)
# PORT=3000

# -------------------------------------------------------------------
# Database Configuration
# ===================================================================
#
# SECURITY: This connection string contains a password.
# NEVER expose it in logs, error messages, or version control.
# Use connection pooling in production (Supabase handles this).
#
# Format: postgres://[user]:[password]@[host]:[port]/[database]
#
# Local development example:
# DATABASE_URL=postgres://postgres:password@localhost:5432/amandi_tharindu
#
# Production: Use Supabase connection string
# (get from Supabase dashboard → Settings → Database → Connection string)
#

DATABASE_URL=postgres://localhost:5432/amandi_tharindu

# -------------------------------------------------------------------
# Session & Security Keys
# ===================================================================
#
# CRITICAL: These keys must be:
#   1. Randomly generated (use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
#   2. At least 32 characters long
#   3. Different for each environment (dev/staging/prod)
#   4. Rotated regularly in production
#   5. NEVER shared or committed to git
#
# In production, these MUST be set in your hosting platform's
# secure environment variable storage (Vercel Secrets, etc.).
#

# Signs and encrypts guest session cookies (HTTP-only)
# Prevents session hijacking and tampering
SESSION_SECRET=replace-with-a-secure-random-value

# Signs CSRF tokens to prevent cross-site request forgery
# Regenerated after login
CSRF_SECRET=replace-with-a-secure-random-value

# -------------------------------------------------------------------
# Admin Account Seeding (one-time / rotation only)
# ===================================================================
#
# Only used by `npm run seed:admin` — NOT read by the running server.
# Per PRD, there is exactly one admin account (the couple).
#
# ⚠️ HITL: seeding or rotating the production admin's credentials is a
# "changing admin access/authentication" action — confirm with the couple
# first. See docs/ADMIN_AUTH.md.
#
# ADMIN_EMAIL=couple@example.com
# ADMIN_PASSWORD=a-real-strong-password-at-least-12-chars

# -------------------------------------------------------------------
# Supabase Configuration (Database & Auth)
# ===================================================================
#
# Get these values from your Supabase project dashboard:
# → Settings → API
#
# SECURITY NOTES:
#   • SUPABASE_ANON_KEY: Public, used by client-side code
#     Restrict scope in Row Level Security (RLS) policies
#   • SUPABASE_SERVICE_ROLE_KEY: Secret, admin access
#     NEVER expose to client; use only on server
#

# Supabase project URL (public, used for API endpoints)
# Example: https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=

# Public API key (safe to expose to client, restricted by RLS)
SUPABASE_ANON_KEY=

# Admin API key (KEEP SECRET, server-only)
# NEVER use this on the client side or commit to git
SUPABASE_SERVICE_ROLE_KEY=

# -------------------------------------------------------------------
# External Services (Optional, Future Use)
# ===================================================================

# Twilio (SMS & WhatsApp messaging)
# Get from Twilio Console → Account SID, Auth Token
# Only needed if implementing SMS/WhatsApp reminders
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=

# Resend (Email service)
# Get API key from Resend dashboard
# Only needed if implementing email confirmations/reminders
# RESEND_API_KEY=

# -------------------------------------------------------------------
# Monitoring & Logging (Optional)
# ===================================================================

# Set to 'debug' for verbose logs (development only)
# LOG_LEVEL=info

# External error tracking (e.g., Sentry)
# SENTRY_DSN=

# -------------------------------------------------------------------
# Security Headers & Deployment
# ===================================================================

# Set to the production domain(s) for security headers
# Example: ALLOWED_ORIGINS=amandi-tharindu.com,www.amandi-tharindu.com
# ALLOWED_ORIGINS=

# Enable additional security headers in production
# SECURITY_HEADERS=true

# -------------------------------------------------------------------
# Development Only
# ===================================================================

# Bypass rate limiting in development (NEVER use in production)
# DEBUG_SKIP_RATE_LIMIT=false

# Mock external services in development (testing mode)
# MOCK_EXTERNAL_SERVICES=false
