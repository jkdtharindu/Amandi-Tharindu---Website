# Local development environment variables.
# Copy to .env.local (gitignored) and fill in. Never commit real values.
NODE_ENV=development

# --- Guest session (custom signed cookie; NOT Supabase Auth) ---------------
# Guests authenticate with their InvitationCode, so guest sessions are a signed,
# expiring httpOnly cookie rather than Supabase Auth users. Supabase Auth is
# reserved for the single Admin account (PRD P0-09).
# REQUIRED in production — the app refuses to start unsigned there. In local dev
# an ephemeral per-process secret is generated with a warning if this is unset,
# which means sessions do not survive a dev-server restart. Set it to avoid that.
SESSION_SECRET=replace-with-a-secure-random-value
GUEST_SESSION_TTL_DAYS=30

# --- Supabase (local CLI stack) -------------------------------------------
# Populate from the output of `npx supabase start`. These are LOCAL container
# credentials, not a cloud project. Requires Docker Desktop running.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — never expose to the browser, never prefix NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection, used by scripts/run-migrations.js and
# scripts/seed-local-db.js. From `npx supabase start` output.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Origin used for CSRF/Origin verification in proxy.ts.
NEXT_PUBLIC_SITE_URL=http://localhost:3010

# --- Rate limiting -----------------------------------------------------------
# How many reverse proxies sit between the public internet and this app. The
# login endpoints identify a caller by counting this many entries back from the
# END of X-Forwarded-For, because each trusted proxy appends the peer it saw and
# anything further left was supplied by the caller.
#   0 = app is exposed directly; forwarded headers are ignored entirely and all
#       unidentified callers share one rate-limit budget (production only).
#   1 = one proxy in front, e.g. Vercel or a single nginx. Correct for the
#       planned Vercel deploy, and the default when NODE_ENV=production.
# Setting this HIGHER than the real number of proxies lets callers forge their
# own address and bypass rate limiting; setting it LOWER lumps everyone into one
# budget. It must match the actual deployment.
# TRUSTED_PROXY_COUNT=1

# --- Admin panel (PRD P0-09) ------------------------------------------------
# The single admin account. Generate the hash with:
#   echo "your-password" | npm run admin:set-password
# Format: <16-byte salt hex>:<64-byte scrypt key hex>
# SESSION_SECRET (above) signs the admin session cookie and is required.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=replace-with-output-of-admin:set-password

# Guest relationship/group categories (for filtering and code generation).
# Customize by providing a comma-separated list. Defaults to:
#   Relations,Colleagues,Neighbours,Friends
# Code format uses first 3 letters of category: NEI-RU-742 (Neighbours, Ruwan, random 3 digits)
# GUEST_CATEGORIES=Relations,Colleagues,Neighbours,Friends,Family

# --- Deferred integrations (not wired up yet) ------------------------------
# All sends are HITL-gated per HITL.md — see AGENTS.md before enabling.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=
# RESEND_API_KEY=
