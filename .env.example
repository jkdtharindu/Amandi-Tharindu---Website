# Local development environment variables
NODE_ENV=development

# Database (for local Postgres or Supabase)
# For local Postgres: postgres://user:password@localhost:5432/amandi_tharindu
# For Supabase: Use the connection string from Supabase dashboard
DATABASE_URL=

# Supabase configuration (optional for development; required for production)
# Get these from your Supabase project settings (Settings → API)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Client-side Supabase variables (must be prefixed with NEXT_PUBLIC_ for Next.js)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# External service credentials (for future integrations)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=
# RESEND_API_KEY=
